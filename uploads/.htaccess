ErrorDocument 403 /smk_kelulusan/custom_403.html
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg)$">
    <IfModule authz_core_module>
        Require all granted
    </IfModule>
    <IfModule !authz_core_module>
        Allow from all
    </IfModule>
</FilesMatch>
<IfModule authz_core_module>
    Require all denied
</IfModule>
<IfModule !authz_core_module>
    Deny from all
</IfModule>